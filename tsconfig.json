{
    "compilerOptions": {
        "target": "ESNext",
        "useDefineForClassFields": true,
        "lib": ["DOM", "DOM.Iterable", "ESNext"],
        "allowJs": false,
        "skipLibCheck": true,
        "esModuleInterop": false,
        "allowSyntheticDefaultImports": true,
        "strict": true,
        "forceConsistentCasingInFileNames": true,
        "module": "ESNext",
        "moduleResolution": "Node",
        "resolveJsonModule": true,
        "isolatedModules": true,
        "noEmit": true,
        "jsx": "react-jsx"
    },
    "include": ["src"],
    "exclude": [
        "src/pages/Index_2.tsx",
        "src/pages/Index_3.tsx",
        "src/pages/ComponentCounter.tsx",
        "src/pages/ComponentCounterMalcok2b.tsx",
        "src/pages/Index.refactored.example.tsx",
        "src/pages/biscuit.refactored.example.tsx"
    ],
    "references": [{ "path": "./tsconfig.node.json" }]
}
